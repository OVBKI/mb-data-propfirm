{
  "manifest_version": 3,
  "name": "Quantara Sync",
  "short_name": "Quantara",
  "version": "0.3.0",
  "description": "Sync auto de tes trades PropFirm vers Quantara, depuis n'importe quel dashboard (Lucid, TopstepX, Apex, MFFU, etc.).",
  "author": "Quantara Technologies LLC",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Quantara Sync",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*.lucidtrading.com/*",
    "https://*.topstepx.com/*",
    "https://*.apextraderfunding.com/*",
    "https://*.myfundedfutures.com/*",
    "https://*.tradeify.com/*",
    "https://*.bulenox.com/*",
    "https://*.takeprofittrader.com/*",
    "https://*.tradeday.co/*",
    "https://quantara.tech/*",
    "https://*.quantara.tech/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://*.lucidtrading.com/*"],
      "js": ["content/loader.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["https://*.topstepx.com/*"],
      "js": ["content/loader.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["https://quantara.tech/*", "https://*.quantara.tech/*"],
      "js": ["content/quantara-bridge.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/inject.js"],
      "matches": [
        "https://*.lucidtrading.com/*",
        "https://*.topstepx.com/*"
      ]
    }
  ]
}
