{
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/check-bills",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/monthly-recap",
      "schedule": "0 8 1 * *"
    },
    {
      "path": "/api/cron/onboarding-emails",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/drawdown-guardian",
      "schedule": "30 14 * * 1-5"
    }
  ]
}
