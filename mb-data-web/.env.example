# =============================================================================
# Quantara — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser.
# =============================================================================

# ── Supabase ─────────────────────────────────────────────────────────────────
# Project URL and anon key from Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJI...

# Service role key (server-side only, never expose to client)
# Used by API routes that need admin-level DB access (push, cron, admin, etc.)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJI...

# ── Cloudflare Turnstile (CAPTCHA) ───────────────────────────────────────────
# Site key (public, used in AuthPage login/register widget)
# Get from Cloudflare Dashboard → Turnstile → your site
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...

# ── Vercel Cron ──────────────────────────────────────────────────────────────
# Shared secret for authenticating cron job requests (check-bills, monthly-recap)
# Generate a strong random string (e.g. openssl rand -hex 32)
CRON_SECRET=your-cron-secret-here

# ── Web Push (VAPID) ────────────────────────────────────────────────────────
# Generate a VAPID key pair: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BEl62i...
VAPID_PRIVATE_KEY=your-vapid-private-key
# Contact URI for VAPID (mailto: or https:// URL)
VAPID_SUBJECT=mailto:admin@quantara.tech

# ── Resend (transactional emails) ───────────────────────────────────────────
# API key from https://resend.com/api-keys
# Used by monthly-recap cron and waitlist confirmation emails
RESEND_API_KEY=re_xxxxxxxxxxxx

# ── Finnhub (economic calendar) ─────────────────────────────────────────────
# Free API key from https://finnhub.io/register
# Used by /api/calendar to fetch economic events
FINNHUB_API_KEY=your-finnhub-api-key

# ── Sentry (error tracking) ─────────────────────────────────────────────────
# Get from Sentry Dashboard → your project → Settings → Client Keys (DSN)
# Public DSN (safe to expose to browser, used in sentry.client.config.js)
NEXT_PUBLIC_SENTRY_DSN=https://your-key@oXXXXXXX.ingest.sentry.io/PPPPPPP

# Build-time integration (source maps upload + release tagging on Vercel)
# Optional — without these, runtime error capture still works
# Get from Sentry → Settings → Auth Tokens (with project:releases + org:read scopes)
SENTRY_ORG=quantara
SENTRY_PROJECT=quantara-web
SENTRY_AUTH_TOKEN=sntrys_xxxxxxxxxxxx

# ── Stripe (Billing + Invoicing + Tax) ──────────────────────────────────────
# Clé secrète serveur. JAMAIS préfixée NEXT_PUBLIC_.
# En prod, préférer une clé RESTREINTE (rk_live_…) : Dashboard → Developers →
# API keys → Restricted keys. Permissions minimales requises :
#   Checkout Sessions (write), Customers (write), Billing Portal (write),
#   Subscriptions (read), Invoices (read), Products + Prices (read)
# Pour tester sans compte : npx -y @stripe/cli sandbox create
STRIPE_SECRET_KEY=rk_test_xxxxxxxxxxxx

# Secret de signature du webhook. Dashboard → Developers → Webhooks → ton endpoint.
# En local : stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# Price IDs (price_…, PAS les product IDs prod_…). Un PRODUIT par palier,
# deux PRIX par produit (mensuel + annuel). Ils diffèrent entre sandbox et live.
STRIPE_PRICE_PRO_MONTHLY=price_xxx
STRIPE_PRICE_PRO_YEARLY=price_xxx
STRIPE_PRICE_ELITE_MONTHLY=price_xxx
STRIPE_PRICE_ELITE_YEARLY=price_xxx
STRIPE_PRICE_BUSINESS_MONTHLY=price_xxx
STRIPE_PRICE_BUSINESS_YEARLY=price_xxx

# URL publique du site — utilisée pour success_url / cancel_url / return_url.
NEXT_PUBLIC_SITE_URL=https://quantara.tech
