# Copy to .env (local dev) or set in Railway env vars.

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJI...
# Get from Supabase Dashboard → Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase

# Encryption master key for Rithmic credentials.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-me-with-fernet-key-44-chars-base64=

# Rithmic gateway (production endpoints, see https://yyy3.rithmic.com/PlugInsAndOtherFreeTools.htm)
# Default = R | API Gateway production
RITHMIC_GATEWAY_URI=wss://rituz00100.rithmic.com:443
# Rithmic system name : choose from
#   "Rithmic 04 Colo"  (production)
#   "Rithmic Paper Trading"  (paper)
#   "TopstepTrader"
#   "Apex"
RITHMIC_SYSTEM_NAME=Rithmic Paper Trading

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=https://quantara.tech,http://localhost:3000

# Optional : default sync window (days)
DEFAULT_SYNC_DAYS=90
